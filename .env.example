# ---- Server ----
PORT=3000
# Public origin used in discovery docs and the x402 `resource` URL (optional; derived from the request if unset)
# Required when NODE_ENV=production.
# PUBLIC_BASE_URL=https://api.archibase.dev

# ---- Payments (x402 v2) ----
# Wallet that receives USDC. REQUIRED.
WALLET_ADDRESS=0xYourReceivingWalletAddress
# CAIP-2 network: eip155:84532 = Base Sepolia (testnet, default), eip155:8453 = Base mainnet
# Mainnet also needs a mainnet FACILITATOR_URL (x402.org only settles Base Sepolia).
X402_NETWORK=eip155:84532
# Price per search call in USD, settled in USDC (0.02 => amount "20000", 6 decimals)
PRICE_USD=0.02
# Price per plan for vector geometry (GET /api/v1/plans/{plan_id}/vector)
VECTOR_PRICE_USD=0.10
# Facilitator that verifies + settles payments.
#   https://x402.org/facilitator  -> free public facilitator (Base Sepolia only)
#   your mainnet facilitator URL  -> required for eip155:8453 (e.g. Coinbase CDP)
#   mock                          -> local dev stub, accepts simulated payments, NO funds move.
#                                    Refused when NODE_ENV=production, and on mainnet unless
#                                    ALLOW_MOCK_FACILITATOR=true.
FACILITATOR_URL=https://x402.org/facilitator
# Optional bearer token sent to the facilitator on verify/settle/supported
# FACILITATOR_API_KEY=

# ---- Database ----
# file:<path> (JSON array, default file:data/plans.json) or https://<project>.supabase.co
DATABASE_URL=file:data/plans.json
# Vector geometry: file:<dir> (default file:data/vectors), https://<bucket> with <plan_id>.json + index.json, or none
# VECTOR_STORE_URL=file:data/vectors
# Required only when DATABASE_URL is Supabase (service-role or anon key with SELECT on floor_plans)
# SUPABASE_KEY=

# ---- Test client only (scripts/pay.ts) — never set on the server ----
# BUYER_PRIVATE_KEY=0x...
