{
  "name": "archibase",
  "version": "0.1.0",
  "description": "AI-ready architectural floor plan API, monetized with x402 USDC micropayments on Base",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json",
    "demo": "tsx scripts/demo.ts",
    "pay": "tsx scripts/pay.ts",
    "test": "vitest run",
    "typecheck:tests": "tsc -p tests/tsconfig.json",
    "dev:worker": "wrangler dev",
    "deploy": "wrangler deploy",
    "seed": "tsx scripts/seed.ts",
    "import:swiss": "tsx scripts/import/swiss-dwellings.ts",
    "wallet": "tsx scripts/wallet.ts",
    "supabase:load": "tsx scripts/supabase-load.ts",
    "build:client": "tsx scripts/build-client.ts",
    "build:skill": "tsx scripts/build-skill.ts"
  },
  "dependencies": {
    "@coinbase/x402": "^2.1.0",
    "@hono/node-server": "^2.1.8",
    "@x402/core": "~2.30.0",
    "@x402/evm": "~2.30.0",
    "@x402/extensions": "~2.30.0",
    "@x402/hono": "~2.30.0",
    "hono": "^4.13.18"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@x402/fetch": "~2.30.0",
    "csv-parse": "^5.6.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "viem": "^2.57.19",
    "vitest": "^5.1.0",
    "wrangler": "^4.161.0"
  },
  "overrides": {
    "zod": "4.6.7"
  }
}
