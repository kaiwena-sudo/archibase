{
  "name": "archibase-mcp",
  "version": "0.1.2",
  "description": "MCP server for Archibase: the structured, license-clean, machine-native floorplan corpus for spatial AI, generative design and architecture agents. Pay per call in USDC on Base via x402",
  "mcpName": "io.github.kaiwena-sudo/archibase",
  "type": "module",
  "bin": {
    "archibase-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "start": "node dist/index.js"
  },
  "keywords": [
    "mcp",
    "x402",
    "floor-plans",
    "architecture",
    "base",
    "usdc"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaiwena-sudo/archibase.git",
    "directory": "mcp"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@x402/core": "~2.30.0",
    "@x402/evm": "~2.30.0",
    "@x402/fetch": "~2.30.0",
    "viem": "^2.57.19",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
